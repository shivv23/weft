# ---------------------------------------------------------------------------
# Weft configuration (all values overridable via environment variables).
# Copy to .env and adjust. Nothing here is required for the offline demo:
# with no LLM/embedding keys Weft runs in deterministic heuristic mode.
# ---------------------------------------------------------------------------

# --- FalkorDB ---------------------------------------------------------------
# Single endpoint; per-tenant graphs are provisioned inside this instance.
WEFT_FALKOR_HOST=localhost
WEFT_FALKOR_PORT=6379
# WEFT_FALKOR_PASSWORD=
# WEFT_FALKOR_URL=redis://user:pass@host:6379   # takes precedence over host/port
WEFT_FALKOR_MAX_CONNECTIONS=64

# --- Embeddings (used for vector recall) ------------------------------------
# hash    : deterministic local hashing, no network, dim 256 (offline default)
# openai  : OpenAI-compatible embeddings API (OpenAI, Azure, vLLM, Ollama /v1)
# ollama  : local Ollama embeddings
WEFT_EMBEDDINGS_PROVIDER=hash
# WEFT_EMBEDDINGS_MODEL=text-embedding-3-small
# WEFT_EMBEDDINGS_DIM=256
# WEFT_OPENAI_API_KEY=sk-...
# WEFT_OPENAI_BASE_URL=https://api.openai.com/v1
# WEFT_OLLAMA_URL=http://localhost:11434

# --- LLM (used for memory consolidation / extraction) ------------------------
# none     : heuristic rule-based extraction (offline, deterministic)
# openai   : any OpenAI-compatible chat API
# anthropic: Claude
# ollama   : local Ollama chat
WEFT_LLM_PROVIDER=none
# WEFT_LLM_MODEL=gpt-4o-mini
# WEFT_ANTHROPIC_API_KEY=sk-ant-...
# WEFT_LLM_TEMPERATURE=0.0
# WEFT_LLM_MAX_TOKENS=2048

# --- Consolidation worker ----------------------------------------------------
WEFT_CONSOLIDATION_ENABLED=true
WEFT_CONSOLIDATION_POLL_SECONDS=1.0
WEFT_CONSOLIDATION_BATCH=8
# Run the multi-tenant worker pool inside the API process (dev convenience).
# In production run it as its own service: `weft worker` (scales independently).
WEFT_WORKERS_IN_API=false
WEFT_WORKER_TENANT_REFRESH_SECONDS=30.0
WEFT_MAINTENANCE_INTERVAL_SECONDS=300.0

# --- Memory lifecycle --------------------------------------------------------
# Salience half-life: after N days an untouched episode loses half its weight.
WEFT_EPISODE_HALF_LIFE_DAYS=14.0
# Episodes older than this with salience below the floor get archived.
WEFT_EPISODE_ARCHIVE_AFTER_DAYS=90
WEFT_EPISODE_ARCHIVE_SALIENCE=0.05
# A (subject, predicate, object) fact is promoted to high-confidence at N evidence hits.
WEFT_FACT_PROMOTE_EVIDENCE=3
# A repeated action sequence of length >= this is mined into a Procedure.
WEFT_PROCEDURE_MIN_SUPPORT=2

# --- Retrieval scoring weights ----------------------------------------------
WEFT_WEIGHT_VECTOR=0.35
WEFT_WEIGHT_FULLTEXT=0.15
WEFT_WEIGHT_GRAPH=0.20
WEFT_WEIGHT_RECENCY=0.15
WEFT_WEIGHT_IMPORTANCE=0.10
WEFT_WEIGHT_FREQUENCY=0.05

# --- API ---------------------------------------------------------------------
# Format: key:tenant[:role]  (comma separated). Empty disables auth (dev mode).
# WEFT_API_KEYS=change-me:demo:admin,other-key:acme
WEFT_API_KEYS=
WEFT_CORS_ORIGINS=["*"]
WEFT_API_HOST=0.0.0.0
WEFT_API_PORT=8080
